# Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional — default is claude-sonnet-4-6 (hyphens; not claude-sonnet-4.6).
# Must be the Messages API model id only — not "anthropic/..." (that form is for AI Gateway).
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional — GitHub token to raise API rate limits when loading repos
# (https://github.com/settings/tokens). Without it the app uses the
# anonymous limit (60 requests/hour per IP).
# GITHUB_TOKEN=
